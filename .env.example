DATABASE_URL="file:./dev.db"
VITE_API_URL="http://localhost:4000"

# Optional. 32+ char passphrase used to derive the AES key that encrypts stored
# credentials. If unset, a random key is generated at prisma/.secret.key on first
# use. Set this explicitly for production / shared deployments.
# AGENTBOARD_SECRET_KEY=""

# Optional overrides for the local agent CLIs (defaults: `claude`, `codex` on PATH).
# AGENTBOARD_CLAUDE_BIN="claude"
# AGENTBOARD_CODEX_BIN="codex"
