generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum PlanStatus {
  Draft
  Approved
  Archived
}

enum TaskStatus {
  Backlog
  Ready
  Running
  Review
  Blocked
  Done
}

enum TaskPriority {
  Low
  Medium
  High
  Critical
}

enum ContextType {
  Architecture
  Code
  Design
  API
  Decision
  Constraint
  Example
}

enum ContextSourceType {
  Manual
  File
  Git
  URL
  Figma
}

enum AgentRunStatus {
  Queued
  Running
  Completed
  Failed
}

model Project {
  id                String        @id @default(cuid())
  name              String
  description       String
  gitRepositoryPath String
  gitAccountId      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  gitAccount        GitAccount?   @relation(fields: [gitAccountId], references: [id], onDelete: SetNull)
  plans             Plan[]
  tasks             Task[]
  contextItems      ContextItem[]
  contextPacks      ContextPack[]
  agentRuns         AgentRun[]
}

model Plan {
  id          String     @id @default(cuid())
  projectId   String
  title       String
  description String
  status      PlanStatus @default(Draft)
  createdAt   DateTime   @default(now())
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]
}

model Task {
  id                     String        @id @default(cuid())
  projectId              String
  planId                 String?
  parentTaskId           String?
  title                  String
  description            String
  status                 TaskStatus    @default(Backlog)
  priority               TaskPriority  @default(Medium)
  assignedAgentProfileId String?
  contextPackId          String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  project                Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  plan                   Plan?         @relation(fields: [planId], references: [id], onDelete: SetNull)
  parentTask             Task?         @relation("TaskTree", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks               Task[]        @relation("TaskTree")
  assignedAgentProfile   AgentProfile? @relation(fields: [assignedAgentProfileId], references: [id], onDelete: SetNull)
  contextPack            ContextPack?  @relation(fields: [contextPackId], references: [id], onDelete: SetNull)
  agentRuns              AgentRun[]
}

model ContextItem {
  id              String            @id @default(cuid())
  projectId       String
  title           String
  summary         String
  content         String
  type            ContextType
  tokenEstimate   Int
  tags            String
  sourceType      ContextSourceType
  sourceReference String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contextPackItems ContextPackItem[]
}

model ContextPack {
  id          String            @id @default(cuid())
  projectId   String
  name        String
  description String
  tokenBudget Int
  createdAt   DateTime          @default(now())
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items       ContextPackItem[]
  tasks       Task[]
}

model ContextPackItem {
  contextPackId String
  contextItemId String
  contextPack   ContextPack @relation(fields: [contextPackId], references: [id], onDelete: Cascade)
  contextItem   ContextItem @relation(fields: [contextItemId], references: [id], onDelete: Cascade)

  @@id([contextPackId, contextItemId])
}

model AgentProfile {
  id           String      @id @default(cuid())
  name         String
  description  String
  systemPrompt String
  model        String
  provider     String      @default("mock")
  runtimeKind  String      @default("api")
  credentialId String?
  baseUrl      String?
  temperature  Float?
  maxTokens    Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @default(now()) @updatedAt
  credential   Credential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  tasks        Task[]
  agentRuns    AgentRun[]
}

model AgentRun {
  id              String         @id @default(cuid())
  projectId       String
  taskId          String
  agentProfileId  String
  status          AgentRunStatus @default(Queued)
  prompt          String
  output          String
  error           String?
  contextSnapshot String
  startedAt       DateTime
  completedAt     DateTime?
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task            Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agentProfile    AgentProfile   @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  tokenUsage      TokenUsage?
}

model TokenUsage {
  id               String   @id @default(cuid())
  agentRunId       String   @unique
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  estimatedCost    Float
  agentRun         AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
}

model Credential {
  id            String         @id @default(cuid())
  name          String
  kind          String
  provider      String
  encrypted     String
  preview       String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
  agentProfiles AgentProfile[]
  gitAccounts   GitAccount[]
}

model GitAccount {
  id           String      @id @default(cuid())
  name         String
  host         String      @default("github")
  authorName   String
  authorEmail  String
  apiBaseUrl   String?
  remoteUrl    String?
  credentialId String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @default(now()) @updatedAt
  credential   Credential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  projects     Project[]
}
